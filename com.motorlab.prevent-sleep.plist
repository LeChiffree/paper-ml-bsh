  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/berfin/paper-ml-bsh/paper_trade_app/logs/prevent-sleep.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/berfin/paper-ml-bsh/paper_trade_app/logs/prevent-sleep.log</string>
</dict>
</plist>
